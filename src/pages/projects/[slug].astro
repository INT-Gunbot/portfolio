---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingShapes from '../../components/FloatingShapes.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: any;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, tags, links, date, cover } = project.data;

const categoryLabel: Record<string, string> = {
  code: '代码',
  design: '设计',
  writing: '写作',
};
---
<BaseLayout title={`${title} | 我的作品集`} description={description}>
  <section class="relative overflow-hidden">
    <FloatingShapes />
    <article class="relative mx-auto max-w-2xl px-6 py-16">
      {cover && (
        <Image src={cover} alt={`${title} 封面`} class="mb-6 w-full rounded-2xl object-cover" loading="lazy" />
      )}
      <header>
        <a href="/projects" class="text-sm text-ink/50 hover:text-coral transition">← 返回作品</a>
        <h1 class="mt-3 font-display text-4xl">{title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-cream px-2 py-0.5 text-xs text-ink/60">{categoryLabel[category] ?? category}</span>
          {date && (
            <time class="text-sm text-ink/50" datetime={date.toISOString()}>
              {date.toLocaleDateString('zh-CN')}
            </time>
          )}
        </div>
        {tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <li class="rounded-full bg-ink/5 px-2 py-0.5 text-xs text-ink/60">{tag}</li>
            ))}
          </ul>
        )}
        {(links?.demo || links?.repo || links?.article) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {links.demo && (
              <a href={links.demo} class="rounded-full bg-coral px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition">演示</a>
            )}
            {links.repo && (
              <a href={links.repo} class="rounded-full border border-ink/20 px-4 py-2 text-sm font-medium hover:border-coral hover:text-coral transition">仓库</a>
            )}
            {links.article && (
              <a href={links.article} class="rounded-full border border-ink/20 px-4 py-2 text-sm font-medium hover:border-coral hover:text-coral transition">文章</a>
            )}
          </div>
        )}
      </header>
      <div class="mt-8 space-y-4 text-ink/80">
        <Content />
      </div>
    </article>
  </section>
</BaseLayout>
